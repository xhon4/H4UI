#!/usr/bin/env bash
# ┌─ H4UI ──────────────────────────────────────────────
# │ QUÉ ES:        el comando "h4ui" — tu herramienta para deshacer cambios
# │                 (reset), traer actualizaciones (update), y abrir la
# │                 ayuda de atajos en pantalla (cheatsheet).
# │ PODÉS CAMBIAR: nada acá adentro, salvo que sepas bash.
# │ NO TOQUES:     el formato del manifest.tsv (dos columnas separadas por
# │                 TAB) — lo escribe scripts/lib/backup.sh durante la
# │                 instalación, y este script lo tiene que leer IGUAL.
# │ VA EN:         ~/.local/bin/h4ui (se instala solo al correr install.sh)
# └──────────────────────────────────────────────────────
# 👉 IMPORTANTE: este archivo se instala como una COPIA (no un symlink) y
# no depende del repo H4UI para nada. Podés borrar la carpeta clonada del
# repo entero y "h4ui reset" / "h4ui cheatsheet" van a seguir andando.
# Solo "h4ui update" necesita que el repo original siga existiendo (tiene
# sentido: si lo borraste, no hay de dónde traer novedades).
set -euo pipefail

H4UI_BACKUP_DIR="$HOME/.local/share/h4ui/backup"
H4UI_MANIFEST="$H4UI_BACKUP_DIR/manifest.tsv"
H4UI_SOURCE_FILE="$HOME/.local/share/h4ui/install-source.txt"

info()  { printf "\033[1;36m[info]\033[0m  %s\n" "$*"; }
warn()  { printf "\033[1;33m[warn]\033[0m  %s\n" "$*" >&2; }
error() { printf "\033[1;31m[error]\033[0m %s\n" "$*" >&2; }

# ¿el path está fuera de $HOME? (o sea, es de /usr o /etc y hace falta sudo)
needs_sudo() {
    case "$1" in
        "$HOME"/*) return 1 ;;
        *) return 0 ;;
    esac
}

cmd_help() {
    cat <<'EOF'
h4ui — CLI de H4UI

Uso:
  h4ui reset [componente]   Devuelve tus configs originales (las de ANTES
                            de instalar H4UI). Sin argumento, devuelve
                            TODO lo que H4UI pisó. Con argumento (ej.
                            "hypr", "waybar"), devuelve solo lo que
                            coincide con ese texto en la ruta.
  h4ui update               Baja la última versión del repo (git pull) en
                            la carpeta donde lo clonaste originalmente.
  h4ui cheatsheet           Abre/cierra la hoja de trucos de atajos (eww).
  h4ui help                 Muestra esta ayuda.
EOF
}

cmd_reset() {
    local filter="${1:-}"

    if [ ! -f "$H4UI_MANIFEST" ]; then
        warn "No hay nada para revertir (no encontré $H4UI_MANIFEST)."
        return 0
    fi

    local restored=0
    while IFS=$'\t' read -r dest backup; do
        [ -n "$dest" ] || continue
        if [ -n "$filter" ] && [[ "$dest" != *"$filter"* ]]; then
            continue
        fi
        if [ ! -e "$backup" ]; then
            warn "No encontré el backup de $dest ($backup), lo salteo."
            continue
        fi
        if needs_sudo "$dest"; then
            sudo mkdir -p "$(dirname "$dest")"
            sudo cp -a "$backup" "$dest"
        else
            mkdir -p "$(dirname "$dest")"
            cp -a "$backup" "$dest"
        fi
        info "Restaurado: $dest"
        restored=$((restored + 1))
    done < "$H4UI_MANIFEST"

    if [ "$restored" -eq 0 ]; then
        warn "No restauré nada (¿el filtro '$filter' no matcheó ninguna ruta del manifest?)."
    else
        info "Listo, $restored archivo(s) restaurado(s). Puede que necesites 'hyprctl reload' o reiniciar sesión."
    fi
}

cmd_update() {
    if [ ! -f "$H4UI_SOURCE_FILE" ]; then
        error "No sé de dónde clonaste el repo (no encontré $H4UI_SOURCE_FILE)."
        error "Volvé a clonarlo (git clone <url-del-repo>) y corré ./install.sh de nuevo."
        return 1
    fi

    local repo_dir
    repo_dir="$(cat "$H4UI_SOURCE_FILE")"

    if [ ! -d "$repo_dir/.git" ]; then
        error "La carpeta original del repo ($repo_dir) ya no existe o dejó de ser un repo git."
        error "Volvé a clonarlo (git clone <url-del-repo>) y corré ./install.sh de nuevo."
        return 1
    fi

    info "Actualizando $repo_dir..."
    (cd "$repo_dir" && git pull)
    info "Listo. Para aplicar los cambios a tu sistema, corré: (cd \"$repo_dir\" && ./install.sh)"
}

cmd_cheatsheet() {
    local script="$HOME/.config/hypr/scripts/cheatsheet.sh"
    if [ -x "$script" ]; then
        "$script"
    else
        error "No encontré $script (¿corriste install.sh?)."
        return 1
    fi
}

case "${1:-help}" in
    reset)          shift; cmd_reset "${1:-}" ;;
    update)         cmd_update ;;
    cheatsheet)     cmd_cheatsheet ;;
    help|-h|--help) cmd_help ;;
    *)
        error "Comando desconocido: ${1:-}"
        cmd_help
        exit 1
        ;;
esac
