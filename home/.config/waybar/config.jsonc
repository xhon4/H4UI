// ┌─ H4UI ──────────────────────────────────────────────
// │ QUÉ ES:        qué módulos tiene la barra de arriba (waybar) y qué
// │                 hace cada uno — workspaces, ventana activa, spotify,
// │                 cpu/memoria, audio, bandeja del sistema y reloj.
// │                 El COLOR/vidrio de todo esto vive en style.css, acá
// │                 solo se decide QUÉ se muestra y CÓMO se comporta.
// │ PODÉS CAMBIAR: el orden de "modules-left/center/right" (reordena o
// │                 esconde módulos sacándolos de la lista), los formatos
// │                 de texto/iconos y los intervalos de refresco.
// │ NO TOQUES:     los nombres de módulo (ej. "custom/spotify", "cpu")
// │                 tal cual — tienen que matchear EXACTO el bloque de
// │                 config de ese módulo más abajo, y los selectores CSS
// │                 de style.css (#custom-spotify, #cpu, etc.).
// │ VA EN:         ~/.config/waybar/config.jsonc
// └──────────────────────────────────────────────────────
// r4chi-dotfiles · by occhi
{
    "layer": "top",
    "position": "top",
    "height": 40,          // 👉 alto de la barra en píxeles
    "spacing": 0,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,

    // 👉 estas 3 listas deciden QUÉ módulos aparecen y EN QUÉ ORDEN
    // (izquierda / centro / derecha de la barra). Sacá o reordená nombres
    // acá para esconder o mover un módulo — el bloque de config de cada
    // uno se puede dejar como está, si no aparece en ninguna lista
    // simplemente no se dibuja.
    "modules-left": [
        "custom/launcher",     // el botón "-⩊-" que abre rofi
        "hyprland/workspaces"  // los numeritos/iconos de escritorio (1..9)
    ],

    "modules-center": [
        "hyprland/window"      // nombre de la ventana activa
    ],

    "modules-right": [
        "custom/spotify",  // qué está sonando
        "custom/sep2",
        "cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "pulseaudio",      // volumen / mute
        "custom/sep",
        "custom/sep",
        "custom/sep2",
        "tray",            // bandeja del sistema (iconos de apps en 2do plano)
        "custom/sep",
        "custom/clock"     // hora + calendario en el tooltip
    ],

    "custom/launcher": { "format": "-⩊-", "tooltip": false },
    "custom/sep":      { "format": " ",  "tooltip": false },   // separador finito
    "custom/sep2":     { "format": " | ","tooltip": false },   // separador con barrita "|"

    // Workspaces de Hyprland (los numeritos de escritorio). 👉 format-icons
    // define qué glyph mostrar para cada número — podés cambiarlos por
    // números normales si los katakana no te copan.
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "sort-by-number": true,
        "all-outputs": false,
        "persistent-workspaces": { "*": 5 },
        "format-icons": {
            "1": "い",
            "2": "ろ",
            "3": "は",
            "4": "に",
            "5": "ほ",
            "6": "へ",
            "7": "と",
            "8": "ち",
            "9": "り",
            "default": "い"
        }
    },

    // Ventana activa (título de la app enfocada), en el centro de la barra.
    "hyprland/window": {
        "format": "󱂬  {}",
        "max-length": 35,          // 👉 cuántos caracteres del título mostrar antes de cortar
        "separate-outputs": true,
        "rewrite": { "": "Arch Linux" }   // 👉 texto cuando no hay ninguna ventana enfocada
    },

    // Qué está sonando en Spotify. El texto sale del script
    // spotify_status.sh; acá solo se definen los clicks/scroll.
    "custom/spotify": {
        "exec": "~/.config/waybar/scripts/spotify_status.sh",
        "return-type": "json",
        "interval": 2,      // 👉 cada cuántos segundos vuelve a preguntar
        "on-click": "playerctl --player=spotify play-pause",
        "on-click-middle": "playerctl --player=spotify previous",
        "on-click-right": "playerctl --player=spotify next",
        "on-scroll-up": "playerctl --player=spotify volume 0.05+",
        "on-scroll-down": "playerctl --player=spotify volume 0.05-",
        "tooltip": false
    },

    // Uso de CPU / RAM. 👉 podés cambiar el "interval" (segundos entre
    // actualizaciones) o el ícono/texto de "format".
    "cpu":    { "interval": 1, "format": "󰻠  {usage}% ", "tooltip": false },
    "memory": { "interval": 3, "format": "󰍛  {used:0.1f}G ", "tooltip": false },

    // Volumen. Click izquierdo mutea, click derecho abre pavucontrol
    // (la app gráfica de audio) para elegir dispositivo/apps.
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟  Muted",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5,      // 👉 cuánto sube/baja el volumen por cada "click" de la rueda
        "format-icons": { "default": ["󰕿","󰕿","󰕿","󰖀","󰖀","󰖀","󰖀","󰖁","󰖁","󰕾"] },
        "tooltip": false
    },

    // Estado de red (wifi/ethernet/desconectado). Definido acá pero
    // actualmente NO está en modules-left/center/right, así que no se
    // dibuja en la barra — agregalo a una de esas listas si lo querés ver.
    "network": {
        "format-ethernet": "󰛳",
        "format-disconnected": "󰈂  Disconnected",
        "format-wifi": "󰛳",
        "interval": 1,
        "tooltip": false
    },

    // Bandeja del sistema — íconos de apps corriendo en 2do plano
    // (ej. nm-applet, blueman, udiskie). 👉 icon-size cambia qué tan
    // grandes se ven esos íconos.
    "tray": { "icon-size": 16, "spacing": 5 },

    // Hora en la barra + calendario/eventos en el tooltip (hover). El
    // contenido sale del script clock_calendar.sh.
    "custom/clock": {
        "exec": "~/.config/waybar/scripts/clock_calendar.sh",
        "return-type": "json",
        "interval": 30,     // 👉 cada cuántos segundos se refresca la hora
        "tooltip": true
    }
}